---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Craft from '../components/Craft.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- 1. Header de presentación con navegación tranquila -->
  <Header />

  <!-- Main Landmark para WCAG AA -->
  <main id="contenido-principal">
    <!-- 2. Quiénes somos: Martín & Francina en primera persona -->
    <Hero />

    <!-- 3. Manifiesto del oficio y panadería de masa madre -->
    <Marquee />

    <!-- 4. Nuestra cocina: lo que hacemos y cómo trabajamos -->
    <Craft />
  </main>

  <!-- 5. El Espacio en Arias 730 y Contacto -->
  <Footer />
</Layout>
