---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Philosophy from '../components/Philosophy.astro';
import BehindTheFire from '../components/BehindTheFire.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- 1. Header de presentación con navegación -->
  <Header />

  <!-- Main Landmark para WCAG AA -->
  <main id="contenido-principal">
    <!-- 2. Hero con identidad de marca y producto estrella -->
    <Hero />

    <!-- 3. Marquee con el manifiesto del oficio -->
    <Marquee />

    <!-- 4. La Propuesta / Los 3 pilares del oficio -->
    <Philosophy />

    <!-- 5. Los Creadores: Martín & Francina (Storytelling) -->
    <BehindTheFire />
  </main>

  <!-- 6. El Espacio en Arias 730 y Contacto -->
  <Footer />
</Layout>
