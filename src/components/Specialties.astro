---
import { siteConfig, getWhatsAppUrl } from '../config/site';

const specialties = siteConfig.specialties;
const whatsappUrl = getWhatsAppUrl('especialidades');
---

<section class="py-24 sm:py-32 relative overflow-hidden border-t border-brand-border/80" id="especialidades">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Encabezado de sección -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">

      <h2 class="font-serif text-3xl sm:text-5xl font-normal tracking-tight text-brand-dark leading-[1.12]">
        Nuestras especialidades <span class="italic font-light text-brand-dark/85">en Junín</span>
      </h2>

      <p class="text-brand-dark/85 text-base sm:text-lg font-sans font-normal leading-relaxed">
        Lotes chicos, materia prima de verdad y elaboración diaria en Arias 730.
      </p>
    </div>

    <!-- Grilla de especialidades tentadoras con fotografía gastronómica -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {specialties.map((item, idx) => (
        <div class="bg-white rounded-3xl p-6 sm:p-7 border border-brand-border/80 shadow-[0_10px_30px_rgba(28,22,20,0.04)] hover:shadow-[0_20px_40px_rgba(28,22,20,0.08)] transition-all duration-300 flex flex-col justify-between group">
          <div class="space-y-4">
            <!-- Fotografía de la especialidad -->
            <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden relative shadow-sm bg-brand-card">
              <img
                src={item.image}
                alt={item.imageAlt}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute top-3 left-3 text-[11px] font-sans font-bold uppercase tracking-wider text-brand-dark bg-white/95 backdrop-blur-md px-3 py-1 rounded-full shadow-sm">
                {item.tag}
              </span>
              <span class="absolute top-3 right-3 text-xs font-serif font-light text-brand-dark/70 bg-white/90 backdrop-blur-md w-7 h-7 rounded-full flex items-center justify-center shadow-sm">
                0{idx + 1}
              </span>
            </div>

            <!-- Título & Subtítulo -->
            <div>
              <h3 class="font-serif text-2xl text-brand-dark font-normal tracking-tight group-hover:text-brand-orange transition-colors">
                {item.title}
              </h3>
              <p class="font-sans text-xs font-semibold text-brand-muted uppercase tracking-wider mt-1">
                {item.subtitle}
              </p>
            </div>

            <!-- Descripción -->
            <p class="text-brand-muted text-sm leading-relaxed font-sans font-normal">
              {item.description}
            </p>
          </div>

          <div class="pt-5 mt-5 border-t border-brand-border/60">
            <span class="text-xs font-sans font-medium text-brand-dark/70 flex items-center gap-1.5">
              <span>Elaborado en Arias 730</span>
              <span>&bull;</span>
              <span>Retiro en el taller</span>
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bloque fotográfico y llamado al antojo -->
    <div class="mt-16 bg-white rounded-3xl p-8 sm:p-12 border border-brand-border/80 shadow-[0_20px_50px_rgba(28,22,20,0.05)] flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      
      <!-- Imagen de las danesas de hojaldre recién salidas del horno -->
      <div class="w-full lg:w-5/12 aspect-[4/3] rounded-2xl overflow-hidden relative shadow-md bg-brand-card">
        <img
          src="/images/danesas.webp"
          alt="Danesas de hojaldre y crema recién salidas del horno en La Gulería"
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
        <div class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-md px-3.5 py-1 rounded-full text-white text-xs font-sans font-medium">
          Hornadas del día
        </div>
      </div>

      <!-- Texto cercano y tentador -->
      <div class="w-full lg:w-7/12 space-y-5 text-center lg:text-left">
        <h3 class="font-serif text-2xl sm:text-4xl text-brand-dark font-normal tracking-tight leading-snug">
          ¿Querés asegurarte tu caja o las pastas del fin de semana?
        </h3>
        <p class="text-brand-muted text-base font-sans font-normal leading-relaxed">
          Horneamos tandas limitadas cada día. Escribinos con anticipación por WhatsApp para reservar tus medialunas, tortas negras o el almuerzo del domingo antes de que vuelen.
        </p>
        <div class="pt-2">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-brand-orange hover:bg-brand-orange/90 text-white font-sans text-xs font-semibold uppercase tracking-widest px-7 py-4 rounded-full shadow-md hover:shadow-lg transition-all duration-300 min-h-[48px]"
          >
            <span>Reservar o consultar por WhatsApp</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
