---
import { siteConfig } from '../config/site';

const items = siteConfig.marqueeItems;
---

<section class="relative py-3.5 bg-brand-dark text-white border-y border-brand-dark/40 overflow-hidden select-none" aria-label="Frases destacadas de marca">
  <div class="flex overflow-hidden">
    <!-- Grupo 1 -->
    <div class="animate-marquee flex items-center gap-10 py-0.5 whitespace-nowrap">
      {items.map((phrase) => (
        <span class="inline-flex items-center gap-6 font-serif italic text-base sm:text-lg text-white/95 tracking-wide">
          <span>{phrase}</span>
          <span class="text-brand-orange text-sm" aria-hidden="true">&bull;</span>
        </span>
      ))}
    </div>

    <!-- Grupo 2 (Duplicado para loop infinito fluido, oculto para lectores de pantalla) -->
    <div class="animate-marquee flex items-center gap-10 py-0.5 whitespace-nowrap" aria-hidden="true">
      {items.map((phrase) => (
        <span class="inline-flex items-center gap-6 font-serif italic text-base sm:text-lg text-white/95 tracking-wide">
          <span>{phrase}</span>
          <span class="text-brand-orange text-sm">&bull;</span>
        </span>
      ))}
    </div>
  </div>
</section>
