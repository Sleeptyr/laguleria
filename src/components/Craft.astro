---
import { siteConfig } from '../config/site';

const { badge, title, subtitle, details } = siteConfig.craft;
---

<section class="py-20 sm:py-28 relative overflow-hidden bg-transparent border-t border-brand-dark/15" id="nuestra-cocina">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      
      <!-- Foto del producto / hojaldre artesanal -->
      <div class="w-full lg:w-5/12 flex justify-center">
        <div class="relative w-full max-w-sm sm:max-w-md aspect-square p-2">
          
          <div class="absolute -top-4 -left-4 w-28 h-28 bg-brand-surface/40 rounded-full blur-lg -z-10" aria-hidden="true"></div>

          <div class="w-full h-full rounded-[2.5rem] overflow-hidden border-4 border-brand-surface shadow-[0_15px_35px_rgba(38,31,28,0.22)] relative group bg-brand-surface/20">
            <img
              src="/images/hero-plato.webp"
              alt="Medialunas artesanales de masa madre y manteca en La Gulería"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-4 right-4 text-brand-surface text-xs sm:text-sm font-medium tracking-wide pointer-events-none">
              <span class="bg-brand-dark/85 backdrop-blur-sm px-3.5 py-1 rounded-full shadow-sm font-medium">
                Masa madre & manteca pura
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- Relato de lo que hacen y cómo cocinan -->
      <div class="w-full lg:w-7/12 space-y-6 text-center lg:text-left">
        
        <div class="inline-block bg-brand-surface/90 text-brand-dark px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider border border-brand-dark/15 shadow-sm">
          {badge}
        </div>

        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-brand-dark select-none leading-tight">
          <span class="text-brand-orange drop-shadow-[0_2px_4px_rgba(38,31,28,0.22)]">Masa madre,</span>{" "}
          <span class="text-brand-yellow drop-shadow-[0_2px_4px_rgba(38,31,28,0.28)]">manteca y</span>{" "}
          <span class="text-brand-surface drop-shadow-[0_2px_4px_rgba(38,31,28,0.22)]">paciencia.</span>
        </h2>

        <p class="text-brand-dark/85 text-base sm:text-lg font-normal leading-relaxed">
          {subtitle}
        </p>

        <!-- Tres detalles de elaboración artesanal -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 text-left">
          {details.map((item, idx) => (
            <div class="pt-4 border-t-2 border-brand-dark/25">
              <span class="font-display text-2xl text-brand-orange drop-shadow-sm block mb-1">
                0{idx + 1}
              </span>
              <h3 class="font-semibold text-base text-brand-dark mb-1.5">
                {item.title}
              </h3>
              <p class="text-brand-dark/75 text-xs sm:text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>
