---
import { siteConfig } from '../config/site';

const { badge, title, subtitle, details } = siteConfig.craft;
---

<section class="py-24 sm:py-32 relative overflow-hidden border-t border-brand-border/80" id="nuestra-cocina">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      
      <!-- Fotografía de producto artesanal -->
      <div class="w-full lg:w-5/12 flex justify-center">
        <div class="relative w-full max-w-sm sm:max-w-md aspect-square p-3 bg-white rounded-3xl shadow-[0_20px_50px_rgba(28,22,20,0.06)] border border-brand-border/70">
          
          <div class="w-full h-full rounded-2xl overflow-hidden relative group bg-brand-card">
            <img
              src="/images/hero-plato.webp"
              alt="Medialunas artesanales de masa madre y manteca en La Gulería"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-3.5 left-3.5 right-3.5 text-white text-xs font-sans font-medium flex items-center justify-between pointer-events-none">
              <span class="bg-black/50 backdrop-blur-md px-3 py-1 rounded-full text-[11px] tracking-wide">
                Masa madre viva & manteca pura
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- Relato de oficio y pilares -->
      <div class="w-full lg:w-7/12 space-y-6 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 border border-brand-border/80 text-xs font-sans font-semibold uppercase tracking-widest text-brand-dark/80 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
          <span>Nuestra Cocina &bull; Sin Atajos</span>
        </div>

        <h2 class="font-serif text-3xl sm:text-5xl lg:text-5xl font-normal tracking-tight text-brand-dark leading-[1.12] select-none">
          Masa madre, manteca y <span class="italic font-light text-brand-dark/85">paciencia</span>.
        </h2>

        <p class="text-brand-muted text-base sm:text-lg font-sans font-normal leading-relaxed max-w-xl mx-auto lg:mx-0">
          {subtitle}
        </p>

        <!-- Tres tarjetas editoriales de oficio -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-3 text-left">
          {details.map((item, idx) => (
            <div class="bg-white p-5 rounded-2xl border border-brand-border/70 shadow-sm hover:shadow-md transition-shadow">
              <span class="font-serif text-2xl font-light text-brand-orange block mb-2">
                0{idx + 1}
              </span>
              <h3 class="font-sans text-sm font-bold uppercase tracking-wider text-brand-dark mb-1.5">
                {item.title}
              </h3>
              <p class="text-brand-muted text-xs leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>
