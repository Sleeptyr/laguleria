---
import { siteConfig, getWhatsAppUrl } from '../config/site';

const whatsappUrl = getWhatsAppUrl('header');
---

<header class="fixed top-3 left-0 right-0 z-50 px-4 sm:px-6 pointer-events-none">
  <div class="max-w-4xl mx-auto flex items-center justify-between bg-brand-surface/95 backdrop-blur-md px-4 sm:px-6 py-2.5 rounded-full border border-brand-border/60 shadow-[0_8px_30px_rgba(0,0,0,0.12)] pointer-events-auto transition-transform duration-300">
    
    <!-- Logo oficial con microanimación -->
    <a 
      href="/" 
      class="group flex items-center gap-2.5 focus:outline-none"
      aria-label="Ir al inicio de La Gulería"
    >
      <img 
        src="/images/logo-laguleria.webp" 
        alt="Logo La Gulería" 
        width="36" 
        height="36" 
        class="w-9 h-9 rounded-full object-cover border border-brand-border shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
      />
      <span class="font-logo tracking-tight text-2xl sm:text-3xl lowercase flex items-baseline gap-1">
        <span class="text-brand-pink">la</span>
        <span class="text-brand-dark">gulería</span>
      </span>
    </a>

    <!-- Enlaces de navegación tranquila -->
    <nav class="hidden md:flex items-center gap-7 font-sans font-medium text-xs uppercase tracking-widest text-brand-muted">
      <a href="#quienes-somos" class="hover:text-brand-dark transition-colors">Quiénes somos</a>
      <a href="#especialidades" class="hover:text-brand-dark transition-colors">Especialidades</a>
      <a href="#espacio" class="hover:text-brand-dark transition-colors">Arias 730</a>
    </nav>

    <!-- Botón de contacto -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-track="click_whatsapp"
      data-location="header"
      class="inline-flex items-center justify-center gap-2 bg-brand-dark hover:bg-black text-white text-xs font-sans font-semibold uppercase tracking-wider px-5 py-2.5 rounded-full shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5 active:translate-y-0 min-h-[42px]"
      aria-label="Contacto por WhatsApp"
    >
      <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.301-.15-1.782-.879-2.058-.98-.276-.1-.477-.15-.678.15-.2.301-.778.98-.954 1.18-.175.2-.351.226-.652.075-.3-.15-1.268-.468-2.416-1.492-.893-.797-1.496-1.782-1.672-2.083-.175-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.175.2-.301.301-.502.101-.2.05-.376-.025-.526-.075-.15-.678-1.632-.929-2.235-.245-.588-.494-.508-.679-.518l-.578-.01c-.2 0-.527.075-.803.376s-1.054 1.03-1.054 2.513 1.079 2.914 1.23 3.115c.15.2 2.123 3.242 5.143 4.547.718.311 1.279.497 1.716.636.721.23 1.378.197 1.897.12.578-.087 1.782-.728 2.033-1.431.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.351z"/>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.434 5.176L2 22l4.981-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2a8.167 8.167 0 01-4.225-1.177l-.303-.18-3.08.863.87-2.997-.197-.319A8.169 8.169 0 1112 20.2z"/>
      </svg>
      <span>Contacto</span>
    </a>

  </div>
</header>
