---
import { siteConfig } from '../config/site';
import Sprinkles from './Sprinkles.astro';

const { badge, greeting, title, intro, paragraph1 } = siteConfig.story;
---

<section class="relative pt-28 pb-16 sm:pt-36 sm:pb-24 overflow-hidden bg-transparent" id="quienes-somos">
  
  <!-- Formas orgánicas decorativas de fondo -->
  <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 sm:w-[500px] sm:h-[500px] bg-brand-surface/30 blob-shape-1 blur-2xl -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-1/2 -left-32 w-72 h-72 sm:w-[450px] sm:h-[450px] bg-brand-surface/20 blob-shape-2 blur-xl -z-10" aria-hidden="true"></div>

  <!-- Microilustraciones -->
  <Sprinkles />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-16">
      
      <!-- Presentación de Martín y Francina en primera persona -->
      <div class="flex-1 text-center lg:text-left space-y-6">
        
        <!-- Badge superior -->
        <div class="inline-flex items-center gap-2 bg-brand-surface/90 border border-brand-dark/20 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide text-brand-dark shadow-sm">
          <span class="w-2 h-2 rounded-full bg-brand-dark animate-ping"></span>
          <span>{badge} &bull; Junín, Buenos Aires</span>
        </div>

        <!-- Título principal: Saludo cercano y presentación ordenado -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-normal tracking-tight leading-[1.12] select-none text-brand-dark">
          <span class="text-brand-surface drop-shadow-[0_2px_4px_rgba(38,31,28,0.22)]">Hola, somos</span>{" "}
          <span>Martín & Francina.</span>
          <br />
          <span class="text-brand-surface drop-shadow-[0_2px_4px_rgba(38,31,28,0.22)]">
            Bienvenidos a La Gulería.
          </span>
        </h1>

        <!-- Párrafos personales cálidos -->
        <div class="space-y-4 text-brand-dark/85 text-base sm:text-lg font-normal leading-relaxed max-w-xl mx-auto lg:mx-0">
          <p>
            {intro}
          </p>
          <p class="text-brand-dark/75 text-sm sm:text-base">
            {paragraph1}
          </p>
        </div>

        <!-- Botón de exploración tranquilo hacia el proyecto -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#nuestra-cocina"
            class="inline-flex items-center justify-center gap-2 bg-brand-surface hover:bg-white border-2 border-brand-dark/30 hover:border-brand-dark text-brand-dark font-semibold text-sm uppercase tracking-wider px-7 py-3.5 rounded-full shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5 min-h-[48px]"
          >
            <span>Conocé lo que hacemos</span>
            <span>&darr;</span>
          </a>

          <a
            href="#espacio"
            class="inline-flex items-center justify-center gap-2 bg-brand-dark hover:bg-black text-brand-surface font-semibold text-sm uppercase tracking-wider px-7 py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 min-h-[48px]"
          >
            <span>Dónde encontrarnos</span>
            <span>&rarr;</span>
          </a>
        </div>

      </div>

      <!-- Protagonista del Hero: Foto real de los creadores en la cocina -->
      <div class="flex-1 flex justify-center items-center relative w-full max-w-sm sm:max-w-md lg:max-w-none">
        
        <!-- Halo suave de fondo -->
        <div class="absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-brand-surface/40 -z-10 blur-xl" aria-hidden="true"></div>
        
        <!-- Píldora de badge superior -->
        <div class="absolute -top-3 -right-2 sm:right-6 bg-brand-dark text-brand-surface text-xs sm:text-sm font-semibold uppercase tracking-wider px-4 py-1.5 rounded-full shadow-lg z-20 border border-brand-surface/20">
          En nuestra cocina
        </div>

        <!-- Marco vertical de la foto de Martín y Francina -->
        <div class="relative w-64 sm:w-80 lg:w-[380px] aspect-[4/5] p-2" data-parallax="0.15">
          <div class="w-full h-full rounded-[2.5rem] sm:rounded-[3rem] overflow-hidden border-4 border-brand-surface shadow-[0_20px_45px_rgba(38,31,28,0.25)] relative group bg-brand-surface/30">
            <img
              src="/images/creadores.webp"
              alt="Martín Tonidandel y Francina Melo en La Gulería"
              width="524"
              height="652"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-4 right-4 text-brand-surface text-xs sm:text-sm font-bold tracking-wide flex items-center justify-between pointer-events-none">
              <span class="bg-brand-dark/85 backdrop-blur-sm px-3.5 py-1 rounded-full shadow-sm font-medium tracking-wide">
                Martín & Francina &bull; Arias 730
              </span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
