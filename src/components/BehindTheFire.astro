---
import { siteConfig } from '../config/site';

const { badge, title, names, photo, alt, bio } = siteConfig.creators;
---

<section class="py-20 sm:py-28 bg-transparent border-t border-brand-dark/15 relative overflow-hidden" id="creadores">
  
  <!-- Mancha orgánica decorativa -->
  <div class="pointer-events-none absolute top-10 -left-20 w-80 h-80 bg-brand-surface/30 blob-shape-3 blur-2xl -z-10" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-14 bg-brand-surface p-8 sm:p-12 rounded-[2.5rem] border border-brand-border/80 shadow-[0_15px_40px_rgba(0,0,0,0.08)]">
      
      <!-- Foto de los creadores (Martín y Francina) -->
      <div class="w-full md:w-5/12 flex-shrink-0">
        <div class="relative rounded-3xl overflow-hidden shadow-md border-2 border-brand-border aspect-[4/5] bg-brand-primary/20 flex items-center justify-center group">
          <img
            src={photo}
            alt={alt}
            width="524"
            height="652"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
          />
        </div>
      </div>

      <!-- Biografía e historia humana -->
      <div class="w-full md:w-7/12 space-y-5 text-center md:text-left">
        
        <div class="inline-block bg-brand-primary/30 text-brand-dark px-4 py-1.5 rounded-full text-xs font-bouncy font-bold uppercase tracking-wider">
          {badge}
        </div>

        <h2 class="font-display text-3xl sm:text-5xl font-normal tracking-wide text-brand-dark select-none">
          <span class="text-brand-dark inline-block text-[1.05em] transform -rotate-1">Martín</span>{" "}
          <span class="text-brand-primary-dark inline-block text-[1.12em] transform rotate-1">Tonidandel</span>{" "}
          <span class="text-brand-dark/70 text-sm font-bouncy inline-block">&</span>{" "}
          <span class="text-brand-primary-dark inline-block text-[1.12em] transform -rotate-1">Francina</span>{" "}
          <span class="text-brand-dark inline-block text-[1.05em] transform rotate-1">Melo</span>
        </h2>

        <p class="text-brand-dark/85 text-base sm:text-lg leading-relaxed font-normal">
          {bio}
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-4">
          <span class="text-xs font-bouncy font-bold text-brand-dark/70 tracking-widest uppercase bg-brand-cream/40 px-3.5 py-1.5 rounded-full border border-brand-dark/10">
            Cocina con oficio en Arias 730
          </span>
          <a
            href={siteConfig.contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bouncy font-bold text-brand-dark hover:underline underline-offset-4"
          >
            Conocé el día a día en Instagram &rarr;
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
