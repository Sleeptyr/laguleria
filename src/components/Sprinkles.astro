---
// Microilustraciones y chispitas inspiradas en el estilo Twice Bittn
---
<div class="pointer-events-none absolute inset-0 overflow-hidden select-none" aria-hidden="true">
  <!-- Estrella 1 -->
  <svg class="absolute top-[12%] left-[8%] w-6 h-6 text-brand-accent animate-float opacity-80" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z" />
  </svg>

  <!-- Chispita 2 (Punto dulce) -->
  <div class="absolute top-[28%] right-[10%] w-4 h-4 rounded-full bg-brand-primary animate-float-reverse opacity-90 shadow-sm"></div>

  <!-- Remolino / Swirl -->
  <svg class="absolute top-[45%] left-[4%] w-8 h-8 text-brand-primary-dark animate-float opacity-50" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
    <path d="M16 6C10.5 6 6 10.5 6 16C6 21.5 10.5 26 16 26C20.5 26 24 22.5 24 18C24 14.5 21.5 12 18 12C15.5 12 14 13.5 14 15.5" />
  </svg>

  <!-- Estrella 3 -->
  <svg class="absolute top-[65%] right-[7%] w-7 h-7 text-brand-accent animate-float-reverse opacity-75" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z" />
  </svg>

  <!-- Chispita 4 -->
  <div class="absolute top-[80%] left-[12%] w-3.5 h-3.5 rounded-full bg-brand-accent animate-float opacity-80"></div>
  
  <!-- Estrella 5 -->
  <svg class="absolute top-[90%] right-[14%] w-5 h-5 text-brand-primary animate-float opacity-70" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z" />
  </svg>
</div>
